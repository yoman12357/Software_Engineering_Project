# CyberSRS environment configuration
#
# Copy this file to `.env` and adjust values for your local machine.
# Never commit the real `.env` file (it is ignored by git).
#
# All CyberSRS-specific variables use the CYBERSRS_ prefix.

# Application environment: development, testing, production
CYBERSRS_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR
CYBERSRS_LOG_LEVEL=INFO

# SQLite database URL (file path for local SQLite)
CYBERSRS_DATABASE_URL=sqlite:///./data/cybersrs.db

# Frontend/backend ports (used by the development tooling)
CYBERSRS_BACKEND_PORT=8000
CYBERSRS_FRONTEND_PORT=5173

# Security: maximum request body size in bytes (SEC-011, default 1 MB)
CYBERSRS_MAX_REQUEST_BODY_BYTES=1048576

# Security: maximum number of projects stored (SEC-041, default 100)
CYBERSRS_MAX_PROJECTS=100

# Local project-reference uploads (PDF, Markdown, text, CSV)
CYBERSRS_UPLOAD_DIR=./data/uploads
CYBERSRS_MAX_UPLOAD_BYTES=10485760
CYBERSRS_MAX_PROJECT_DOCUMENTS=5
CYBERSRS_MAX_PROJECT_DOCUMENT_CONTEXT_CHARS=12000

# --- LLM integration ---
# Provider selection. Phase 1B uses the deterministic mock provider only;
# the locally installed Qwen / nomic-embed-text models are reserved for
# Phase 2 and are never called while this is "mock".
CYBERSRS_LLM_PROVIDER=mock
# Local Ollama API base URL (local-first; must bind to localhost; Phase 2+)
CYBERSRS_OLLAMA_BASE_URL=http://localhost:11434
# Canonical variant selection and model tags. The legacy MODEL_NAME variable
# remains supported for old base-model installations.
CYBERSRS_MODEL_VARIANT=base
CYBERSRS_BASE_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
CYBERSRS_FINETUNED_MODEL_NAME=cybersrs-qwen3-4b-ft
# Legacy base-model override
CYBERSRS_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
# Maximum retry attempts for LLM calls (SEC-039)
CYBERSRS_LLM_MAX_RETRIES=1
# Timeout per LLM call in seconds (SEC-039)
CYBERSRS_LLM_TIMEOUT_SECONDS=120
# Read/generation timeout for Ollama in seconds (local Qwen defaults)
CYBERSRS_OLLAMA_TIMEOUT_SECONDS=600
# Ollama context window size in tokens
CYBERSRS_OLLAMA_NUM_CTX=8192
# Maximum response tokens; prevents runaway malformed generations
CYBERSRS_OLLAMA_NUM_PREDICT=5200
# Fine-tuned models may require a modest repetition penalty to avoid loops
CYBERSRS_OLLAMA_REPEAT_PENALTY=1.1
CYBERSRS_OLLAMA_REPEAT_LAST_N=256
# Deterministic structured-output decoding
CYBERSRS_OLLAMA_TEMPERATURE=0.0
CYBERSRS_OLLAMA_TOP_P=0.9
# Optional compatibility alias for local shells
OLLAMA_TIMEOUT_SECONDS=600

# --- Embeddings (used from Phase 4 onward) ---
# Embedding model — ALWAYS the local nomic-embed-text model.
# Never use Qwen, DeepSeek, or any external API for embeddings.
CYBERSRS_EMBEDDING_MODEL=nomic-embed-text
# Optional: override the Ollama model-store directory.
# This machine's store lives on the D drive:
CYBERSRS_OLLAMA_MODELS_DIR=D:\LocalAI\Ollama_Models

# --- RAG configuration (used from Phase 4 onward) ---
# Enable retrieval augmentation for SRS generation (supports the plain RAG_ENABLED alias too)
CYBERSRS_RAG_ENABLED=true
# Stable identifier from ai/evaluation/corpus_inventory.json; use "unknown" for legacy indexes.
CYBERSRS_KNOWLEDGE_BASE_VERSION=7591b1d38fd349a9
# ChromaDB persistence directory
CYBERSRS_CHROMA_PATH=./data/chroma
# Separate collection for project-private reference chunks
CYBERSRS_PROJECT_CHROMA_COLLECTION=cybersrs_project_documents
# Number of chunks to retrieve per query
CYBERSRS_RAG_TOP_K=3
# Minimum relevance score threshold (0.0–1.0)
CYBERSRS_RAG_MIN_SCORE=0.45
# Maximum retrieved context characters inserted into one prompt
CYBERSRS_RAG_MAX_CONTEXT_CHARS=6000
# Maximum characters kept from one retrieved chunk in one prompt
CYBERSRS_RAG_MAX_CHUNK_CHARS=1000
# Document chunk size in tokens
CYBERSRS_RAG_CHUNK_SIZE=512
# Chunk overlap in tokens
CYBERSRS_RAG_CHUNK_OVERLAP=64

# --- PDF export (used from Phase 6 onward) ---
# Directory for exported PDFs
CYBERSRS_PDF_OUTPUT_DIR=./data/exports
