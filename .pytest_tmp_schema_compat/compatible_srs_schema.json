{
  "$defs": {
    "ArchitectureComponent": {
      "additionalProperties": false,
      "description": "A component in the high-level system architecture.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "responsibilities": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Responsibilities",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "responsibilities"
      ],
      "title": "ArchitectureComponent",
      "type": "object"
    },
    "ArchitectureSummary": {
      "additionalProperties": false,
      "description": "High-level system architecture description.",
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/ArchitectureComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "data_flows": {
          "items": {
            "type": "string"
          },
          "title": "Data Flows",
          "type": "array"
        },
        "deployment_notes": {
          "default": "",
          "title": "Deployment Notes",
          "type": "string"
        },
        "overview": {
          "minLength": 1,
          "title": "Overview",
          "type": "string"
        }
      },
      "required": [
        "overview",
        "components"
      ],
      "title": "ArchitectureSummary",
      "type": "object"
    },
    "Confidence": {
      "description": "Model self-assessed confidence (PROMPT_AND_OUTPUT_DESIGN \u00a74).",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Mitigation": {
      "additionalProperties": false,
      "description": "A mitigation strategy for a threat (DATA_MODEL \u00a72.10).",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "mitigation_id": {
          "pattern": "^MIT-[0-9]{3}$",
          "title": "Mitigation Id",
          "type": "string"
        },
        "related_requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Requirement Ids",
          "type": "array"
        }
      },
      "required": [
        "mitigation_id",
        "description"
      ],
      "title": "Mitigation",
      "type": "object"
    },
    "Priority": {
      "description": "Requirement priority per MoSCoW (DATA_MODEL \u00a72.7).",
      "enum": [
        "must",
        "should",
        "could"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ProjectOverview": {
      "additionalProperties": false,
      "description": "Executive summary of the project being specified.",
      "properties": {
        "context": {
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "description",
        "purpose",
        "context"
      ],
      "title": "ProjectOverview",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "A single functional, non-functional, security, data, or network\nrequirement (PROMPT_AND_OUTPUT_DESIGN \u00a74 / DATA_MODEL \u00a72.7).",
      "properties": {
        "acceptance_criteria": {
          "minLength": 1,
          "title": "Acceptance Criteria",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/RequirementCategory"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "medium"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "must"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_references": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source References",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "user_confirmed": {
          "default": false,
          "title": "User Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "category",
        "title",
        "statement",
        "rationale",
        "acceptance_criteria"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RequirementCategory": {
      "description": "Category of a generated requirement.",
      "enum": [
        "functional",
        "non_functional",
        "security",
        "data",
        "network"
      ],
      "title": "RequirementCategory",
      "type": "string"
    },
    "Risk": {
      "additionalProperties": false,
      "description": "A project risk recorded in the SRS.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "impact": {
          "minLength": 1,
          "title": "Impact",
          "type": "string"
        },
        "likelihood": {
          "minLength": 1,
          "title": "Likelihood",
          "type": "string"
        },
        "mitigation": {
          "default": "",
          "title": "Mitigation",
          "type": "string"
        },
        "risk_id": {
          "pattern": "^RISK-[0-9]{3}$",
          "title": "Risk Id",
          "type": "string"
        }
      },
      "required": [
        "risk_id",
        "description",
        "likelihood",
        "impact"
      ],
      "title": "Risk",
      "type": "object"
    },
    "SRSMetadata": {
      "additionalProperties": false,
      "description": "Document-level metadata (DATA_MODEL \u00a73 / PDF_AND_REPORT_DESIGN \u00a73).",
      "properties": {
        "adapter_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Name"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inferred_categories": {
          "items": {
            "type": "string"
          },
          "title": "Inferred Categories",
          "type": "array"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "project_name": {
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "project_name",
        "version",
        "generated_at",
        "model_name"
      ],
      "title": "SRSMetadata",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "What is included in and excluded from the SRS.",
      "properties": {
        "in_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "In Scope",
          "type": "array"
        },
        "out_of_scope": {
          "items": {
            "type": "string"
          },
          "title": "Out Of Scope",
          "type": "array"
        }
      },
      "required": [
        "in_scope"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Severity": {
      "description": "Threat severity (DATA_MODEL \u00a72.9).",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "A retrieved-chunk citation on a requirement.\n\nRAG does not exist yet (Phase 1C), so this list must remain empty; it is\ndefined so Phase 4 can populate it without changing the schema.",
      "properties": {
        "document_title": {
          "title": "Document Title",
          "type": "string"
        },
        "relevance_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance Score",
          "type": "number"
        },
        "section_heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Heading"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "document_title",
        "relevance_score"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TestingRecommendation": {
      "additionalProperties": false,
      "description": "A testing recommendation for the project.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "recommendation_id": {
          "pattern": "^TEST-[0-9]{3}$",
          "title": "Recommendation Id",
          "type": "string"
        },
        "related_requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Requirement Ids",
          "type": "array"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "recommendation_id",
        "description",
        "type"
      ],
      "title": "TestingRecommendation",
      "type": "object"
    },
    "Threat": {
      "additionalProperties": false,
      "description": "A threat identified in the threat model (DATA_MODEL \u00a72.9).",
      "properties": {
        "affected_assets": {
          "items": {
            "type": "string"
          },
          "title": "Affected Assets",
          "type": "array"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "mitigations": {
          "items": {
            "$ref": "#/$defs/Mitigation"
          },
          "title": "Mitigations",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "medium"
        },
        "threat_id": {
          "pattern": "^THR-[0-9]{3}$",
          "title": "Threat Id",
          "type": "string"
        }
      },
      "required": [
        "threat_id",
        "name",
        "description"
      ],
      "title": "Threat",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "description": "A single deterministic validation finding.",
      "properties": {
        "issue_id": {
          "default": "",
          "pattern": "^VAL-[0-9]{3}$",
          "title": "Issue Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "requirement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Id"
        },
        "section": {
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/ValidationSeverity",
          "default": "warning"
        }
      },
      "required": [
        "section",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "description": "Result of deterministic SRS validation (FR-050..FR-054).",
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "overall_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Overall Score",
          "type": "integer"
        }
      },
      "required": [
        "overall_score"
      ],
      "title": "ValidationReport",
      "type": "object"
    },
    "ValidationSeverity": {
      "description": "Severity of a deterministic validation issue.",
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "ValidationSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The complete structured Software Requirements Specification.\n\nSections follow the Phase 1C milestone's documented list. ``references``\nand requirement ``source_references`` remain empty because RAG does not\nexist yet (Phase 1C rule: never invent external citations).",
  "properties": {
    "architecture_summary": {
      "$ref": "#/$defs/ArchitectureSummary"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "data_requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Data Requirements",
      "type": "array"
    },
    "functional_requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "minItems": 1,
      "title": "Functional Requirements",
      "type": "array"
    },
    "generation_metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Metadata"
    },
    "metadata": {
      "$ref": "#/$defs/SRSMetadata"
    },
    "mitigations": {
      "items": {
        "$ref": "#/$defs/Mitigation"
      },
      "title": "Mitigations",
      "type": "array"
    },
    "network_requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Network Requirements",
      "type": "array"
    },
    "non_functional_requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Non Functional Requirements",
      "type": "array"
    },
    "project_overview": {
      "$ref": "#/$defs/ProjectOverview"
    },
    "references": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "References",
      "type": "array"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/Risk"
      },
      "title": "Risks",
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "security_requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Security Requirements",
      "type": "array"
    },
    "stakeholders": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Stakeholders",
      "type": "array"
    },
    "testing_strategy": {
      "items": {
        "$ref": "#/$defs/TestingRecommendation"
      },
      "title": "Testing Strategy",
      "type": "array"
    },
    "threats": {
      "items": {
        "$ref": "#/$defs/Threat"
      },
      "title": "Threats",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "user_roles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "User Roles",
      "type": "array"
    },
    "validation_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "metadata",
    "project_overview",
    "scope",
    "stakeholders",
    "user_roles",
    "functional_requirements",
    "architecture_summary"
  ],
  "title": "SRSSchema",
  "type": "object"
}